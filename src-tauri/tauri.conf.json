{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiscordRPC",
  "version": "0.1.0",
  "identifier": "io.github.trxrknocks.discordrpc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DiscordRPC",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "TrxrKnocks",
    "category": "Utility",
    "shortDescription": "Discord Rich Presence manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
